# ─────────────────────────────────────────────────────────────
#  Cave — configuration
#  Copie ce fichier en .env et renseigne les valeurs.
# ─────────────────────────────────────────────────────────────

# Image publiée par le workflow GitHub Actions (publiée sous antoinegilles)
CAVE_IMAGE=ghcr.io/antoinegilles/cave:latest

# Port local écouté sur la loopback. Sert au diagnostic ; Caddy passe par le
# réseau Docker. Change-le s'il entre en conflit avec un autre projet du VPS.
APP_PORT=8093

# Réseau Docker du Caddy partagé, que Cave rejoint pour être joignable par son
# nom de service. À relever sur le VPS avec :
#   docker inspect -f '{{range $k,$v := .NetworkSettings.Networks}}{{$k}} {{end}}' caddy
CADDY_NETWORK=caddy_default

# OBLIGATOIRE en production. Génère-le avec : openssl rand -hex 32
JWT_SECRET=

# Clé Google AI Studio (https://aistudio.google.com/apikey) — free tier, sans carte bancaire.
# Sert au scan d'étiquette ET au sommelier. Sans elle, l'app fonctionne toujours :
# saisie manuelle + recherche par nom, et le sommelier est simplement indisponible.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Provider Vivino. Mettre à false coupe le scraping : les fiches sont alors
# établies depuis l'étiquette et enrichies par les heuristiques cépage/région.
VIVINO_ENABLED=true
VIVINO_MIN_INTERVAL_MS=2000

# Sommelier IA. Le flag en base prime une fois créé — cette valeur ne sert qu'au
# tout premier démarrage. Ensuite, le pilotage se fait depuis la page Admin.
AI_SOMMELIER_ENABLED=true
AI_DAILY_QUOTA=3
# Recherche web Google pendant la réflexion : coûteuse en latence et en tokens.
AI_ENABLE_GROUNDING=false
# Nombre de vins injectés dans le contexte du sommelier (borne la facture en tokens).
AI_MAX_CONTEXT_WINES=60

# Qui peut créer un compte :
#   open   — inscription publique libre (réglage actuel)
#   invite — inscription publique protégée par REGISTRATION_INVITE_CODE
#   closed — seul un administrateur crée les comptes depuis la page Admin
# Passer à `invite` referme l'inscription sans toucher au code ni redéployer.
REGISTRATION_MODE=open
REGISTRATION_INVITE_CODE=

# Compte administrateur créé au tout premier démarrage uniquement.
# Laisse ADMIN_PASSWORD vide pour qu'un mot de passe aléatoire soit généré et
# affiché une seule fois dans les logs (docker compose logs cave).
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=
