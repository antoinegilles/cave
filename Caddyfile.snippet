# ─────────────────────────────────────────────────────────────────────
#  À ajouter dans le Caddyfile partagé du VPS.
#
#  Cave n'expose rien sur Internet : Caddy reste le seul point d'entrée TLS.
#  Le Caddy du VPS étant lui-même conteneurisé, il joint Cave par son nom de
#  service Docker — d'où le `networks` du docker-compose.yml, sans lequel
#  `127.0.0.1:8093` désignerait le conteneur Caddy et renverrait 502.
# ─────────────────────────────────────────────────────────────────────

cave.coffeecount.app {
	reverse_proxy cave:3000

	# Les photos d'étiquette montent jusqu'à ~2 Mo après redimensionnement.
	# Sans cette ligne, Caddy plafonne à 10 Mo et le scan casse en silence.
	request_body {
		max_size 12MB
	}

	encode gzip zstd

	log {
		output file /var/log/caddy/cave.log
		format json
	}
}
